  casi_accidentes_casi_accidentes_id_usuario_gestion_controlTousuarios casi_accidentes[]      @relation("casi_accidentes_id_usuario_gestion_controlTousuarios")
  casi_accidentes_casi_accidentes_id_usuario_prlTousuarios             casi_accidentes[]      @relation("casi_accidentes_id_usuario_prlTousuarios")
